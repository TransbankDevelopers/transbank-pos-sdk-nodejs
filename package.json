{
  "name": "transbank-pos-sdk",
  "version": "4.0.0",
  "description": "SDK Web para POS Integrado en Node.js",
  "main": "dist/transbank.js",
  "scripts": {
    "prepublish": "npm run build",
    "dev": "node ./examples/index.js --watch",
    "build": "webpack",
    "start": "webpack --watch",
    "test": "jest",
    "test:e2e": "jest tests/e2e"
  },
  "keywords": [
    "POS",
    "transbank",
    "serial"
  ],
  "author": {
    "name": "Transbank Developers",
    "email": "transbankdevelopers@continuum.cl"
  },
  "contributors": [
    {
      "name": "Gonzalo De Spírito"
    }
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@serialport/parser-inter-byte-timeout": "^13.0.0",
    "lrc-calculator": "^0.1.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "inquirer": "^13.3.0",
    "jest": "^30.2.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/e2e/jest.setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.spec.js"
    ],
    "testTimeout": 15000
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
